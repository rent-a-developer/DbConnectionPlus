<Project>

	<!--
		Properties shared by EVERY project in the solution - the six shipping libraries, the two test projects
		and the benchmarks. (tests/package-consumption/ is outside this on purpose: it carries its own empty
		Directory.Build.props, which stops MSBuild's upward search before it reaches this file.)

		Anything that only the shipping libraries need belongs in src/Directory.Build.props instead, which
		imports this file. MSBuild uses the NEAREST Directory.Build.props and stops there, so that import is
		what keeps these properties applying under src/ as well.
	-->

	<PropertyGroup>
		<Authors>David Liebeherr</Authors>
		<Company>rent-a-developer</Company>
		<Copyright>Copyright © rent-a-developer / David Liebeherr</Copyright>
	</PropertyGroup>

	<PropertyGroup>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<TieredCompilation>true</TieredCompilation>
	</PropertyGroup>

	<PropertyGroup>
		<!--
			The style gate, and it applies to EVERY project - the shipping libraries, the tests and the
			benchmarks alike. Style, formatting and member ordering are not something test code is exempt
			from; a slip is a build error there too.

			EnforceCodeStyleInBuild is what makes the IDExxxx code-style rules and the StyleCop ordering
			rules run during the build rather than only in the IDE, and TreatWarningsAsErrors turns them
			into build breaks. Where a rule genuinely does not fit test code it is switched off for tests/
			and benchmarks/ in .editorconfig, not by weakening the gate here.

			The CA quality rules are a separate matter and stay in src/Directory.Build.props. Holding test
			code to them is a much bigger change than holding it to a style - CA1707 alone fires 2100 times
			on the Method_ShouldDoSomething naming the test suite is built around.
		-->
		<EnforceCodeStyleInBuild>True</EnforceCodeStyleInBuild>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>

		<!--
			SA0001 says XML comment analysis is off because the project does not generate a documentation
			file, which is true and deliberate for tests/ and benchmarks/. It cannot be switched off in
			.editorconfig with the rest of the StyleCop rules: it is reported against the compilation with
			no file location, and an .editorconfig section can only reach a diagnostic that has one.
		-->
		<NoWarn>$(NoWarn);SA0001</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<!--
			The style analyzers every project is held to. They are PrivateAssets=all, so they never flow to a
			consumer of the packages.
		-->
		<PackageReference Include="ErrorProne.NET.CoreAnalyzers" Version="0.1.2">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Roslynator.Analyzers" Version="5.0.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<!--
			The member-ordering checker. It is here for that one job - see the ordering section of
			.editorconfig, which switches every StyleCop category off and turns only the ordering rules
			plus SA1309 back on.

			This is the NewStyleCop.Analyzers fork, not StyleCop.Analyzers. Upstream's last release is
			1.2.0-beta.556 from December 2023 and predates the C# this repository writes; the fork ships
			stable releases and handles C# 14 extension declarations and collection expressions. The rule
			IDs and stylecop.json are identical, so going back to upstream is a one-line change here.
		-->
		<PackageReference Include="NewStyleCop.Analyzers" Version="1.2.1">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="SonarAnalyzer.CSharp" Version="10.33.0.1635">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<!-- One stylecop.json for the whole repository; $(MSBuildThisFileDirectory) is the repository root. -->
		<AdditionalFiles Include="$(MSBuildThisFileDirectory)stylecop.json" Link="stylecop.json" />
	</ItemGroup>

</Project>
