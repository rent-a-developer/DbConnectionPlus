<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!--
      <clear /> first: a developer's machine-wide NuGet.config may add private or company feeds, and a
      restore that silently succeeds from one of those produces a build nobody else can reproduce - least of
      all CI. nuget.org is the only source this repository builds from.
    -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
