<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>RentADeveloper.DbConnectionPlus.DatabaseAdapters.MySql</AssemblyName>
    <AssemblyTitle>rent-a-developer DbConnectionPlus MySql Database Adapter</AssemblyTitle>
    <Description>MySQL database adapter for DbConnectionPlus.</Description>
    <!-- Packing is opt-in: the repository-root Directory.Build.props sets IsPackable=false. -->
    <IsPackable>true</IsPackable>
    <PackageId>DbConnectionPlus.DatabaseAdapters.MySql</PackageId>
    <RootNamespace>RentADeveloper.DbConnectionPlus.DatabaseAdapters.MySql</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DbConnectionPlus\DbConnectionPlus.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MySqlConnector" />
  </ItemGroup>

</Project>
