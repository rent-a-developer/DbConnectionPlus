<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>RentADeveloper.DbConnectionPlus</AssemblyName>
    <AssemblyTitle>rent-a-developer DbConnectionPlus</AssemblyTitle>
    <Description>A lightweight .NET ORM and extension library for the type DbConnection that adds high-performance, type-safe helpers to reduce boilerplate code, boost productivity, and make working with SQL databases in C# more enjoyable.</Description>
    <!-- Packing is opt-in: the repository-root Directory.Build.props sets IsPackable=false. -->
    <IsPackable>true</IsPackable>
    <PackageId>DbConnectionPlus</PackageId>
    <PackageTags>ORM sql server mysql postgresql sqlite oracle SqlConnection DbConnection extensions connection entity insert delete update CRUD</PackageTags>
    <RootNamespace>RentADeveloper.DbConnectionPlus</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Travels with the assembly so that ILLink and ILC honour it in a consuming application's trimmed or
      Native AOT publish. See the file itself for what it keeps and why an annotation cannot do it.
    -->
    <EmbeddedResource Include="ILLink.Descriptors.xml">
      <LogicalName>ILLink.Descriptors.xml</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Humanizer.Core" />
    <PackageReference Include="LinkDotNet.StringBuilder" />
  </ItemGroup>

</Project>
