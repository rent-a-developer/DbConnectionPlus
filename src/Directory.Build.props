<Project>

  <!--
    Shared build properties for the shipping libraries.

    The repository-root Directory.Build.props carries what every project needs (authorship, language
    settings, the style analyzers, and the style gate itself - EnforceCodeStyleInBuild with
    TreatWarningsAsErrors). MSBuild uses the nearest Directory.Build.props and stops, so this file imports
    it explicitly - without that import, the projects under src/ would silently lose all of it.

    What lives here is what only a shipping, packable library needs: multi-targeting, the AOT, CA and
    public-API analyzers, and the NuGet package metadata. Per-project identity - AssemblyName,
    AssemblyTitle, RootNamespace, PackageId, Description, PackageTags - stays in each .csproj, and so does
    IsPackable=true, because packing is opt-in.

    Two things live elsewhere on purpose. <Version> is in the repository-root
    Directory.Build.props, so one file answers "what version is this repository at". The files the packages
    carry are in the repository-root Directory.Build.targets, because they are conditioned on IsPackable,
    which a project sets after every .props file has been read.
  -->

  <Import Project="$(MSBuildThisFileDirectory)../Directory.Build.props" />

  <PropertyGroup>
    <!--
      net8.0 is the documented Native AOT floor; net10.0 is the recommended target.

      The unit tests multi-target the same pair, because the net8.0 and net10.0 builds of these libraries
      are not the same code - net8.0 carries an IL3050 suppression net10.0 does not. The integration tests stay
      net8.0 (they are bound by database containers, not by the runtime) and the benchmarks are net10.0
      (BenchmarkDotNet's NativeAotToolchain.Net10_0 publishes that TFM).
    -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      Enables the trim, AOT and single-file analyzers, and marks the produced assemblies trimmable
      via [assembly: AssemblyMetadata("IsTrimmable", "True")].
    -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      The CA quality rules, at their broadest setting, for the shipping libraries only. The style gate
      that every project shares - EnforceCodeStyleInBuild and TreatWarningsAsErrors - lives in the
      repository-root Directory.Build.props instead.
    -->
    <AnalysisLevel>latest-all</AnalysisLevel>
    <EnableNETAnalyzers>True</EnableNETAnalyzers>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      Every shipping project produces a package, but only on demand: CI packs on every run and
      publishes only for a pushed version tag. See the "Releases" section of AGENTS.md.
    -->
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      Package metadata that is identical for every package. The rest is per-project, and the files the
      packages carry are added by the repository-root Directory.Build.targets.

      The licence is an SPDX EXPRESSION rather than a file reference. nuget.org can read an expression -
      it shows "MIT" on the package page and lets a consumer's licence tooling resolve it without opening
      the package - where a file reference is opaque to everything but a human. LICENSE.md is still packed,
      unchanged, so nothing is lost by saying it twice.

      PackageRequireLicenseAcceptance is false because acceptance prompts exist for RESTRICTED licences.
      MIT is not one, and a prompt in front of an MIT package is noise that trains people to click through
      the prompts that matter.
    -->
    <PackageIcon>logo-128.png</PackageIcon>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/rent-a-developer/DbConnectionPlus</PackageProjectUrl>
    <PackageReadmeFile>PACKAGE_README.md</PackageReadmeFile>
    <PackageReleaseNotes>https://github.com/rent-a-developer/DbConnectionPlus/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <RepositoryType>GIT</RepositoryType>
    <RepositoryUrl>https://github.com/rent-a-developer/DbConnectionPlus.git</RepositoryUrl>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      Package validation, against the LAST PUBLISHED version of each package rather than against nothing.

      Without PackageValidationBaselineVersion the check is limited to internal consistency - that the
      package's target frameworks are compatible with each other - which cannot see the failure that
      actually matters: a member that shipped and is now gone. With the baseline, `dotnet pack` downloads
      the published package and runs ApiCompat against it, so removing or changing a public signature
      fails the pack rather than reaching nuget.org.

      The baseline is the version currently on nuget.org. At a release it moves to the version being
      replaced, alongside the <Version> bump in the repository-root Directory.Build.props.
    -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>4.0.0</PackageValidationBaselineVersion>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Guards the public surface of every shipping package: a public member that is not listed in the
      project's PublicAPI.*.txt files is RS0016, and removing a listed one is RS0017 - both build errors
      here, because TreatWarningsAsErrors is on. Update the files with scripts/update-public-api.ps1.
    -->
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" Condition="Exists('PublicAPI.Shipped.txt')" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" Condition="Exists('PublicAPI.Unshipped.txt')" />
  </ItemGroup>

</Project>
