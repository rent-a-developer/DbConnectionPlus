<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!--
      An isolated package cache. The freshly packed version X.X.X of DbConnectionPlus carries the same version number as a X.X.X version that
      may already sit in the machine-wide cache, and NuGet resolves by version, not by content - without
      this the consumers could silently restore yesterday's build. Delete this folder to pick up a re-pack.
    -->
    <add key="globalPackagesFolder" value=".packages" />
  </config>
  <packageSources>
    <clear />
    <!-- The packages under test, produced by `dotnet pack ... -o artifacts/packages`. -->
    <add key="local-packages" value="../../artifacts/packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
